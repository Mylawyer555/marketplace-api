generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Address {
  address_id       Int         @id @default(autoincrement())
  address_type     addresstype
  user_id          Int
  house_number     String?     @db.VarChar(20)
  apartment_number String?     @db.VarChar(20)
  street           String      @db.VarChar(100)
  state            String      @db.VarChar(100)
  city             String      @db.VarChar(100)
  country          String      @db.VarChar(100)
  delivery_note    String?
  is_default       Boolean     @default(false)
  phone_number     String      @db.VarChar(100)
  created_at       DateTime?   @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?   @updatedAt @db.Timestamptz(6)
  user             User        @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@map("addresses")
}

model Auditlog {
  audit_log_id Int       @id @default(autoincrement())
  user_id      Int?
  action       String    @db.VarChar(100)
  table_name   String    @db.VarChar(100)
  record_id    Int
  ip_address   String?   @db.VarChar(45)
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  users        User?     @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@map("auditlogs")
}

model CartItem {
  cart_item_id Int            @id @default(autoincrement())
  cart_id      Int
  variant_id   Int
  quantity     Int
  price        Decimal        @db.Decimal(10, 2)
  created_at   DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at   DateTime?      @updatedAt @db.Timestamptz(6)
  carts        Cart           @relation(fields: [cart_id], references: [cart_id], onDelete: NoAction, onUpdate: NoAction)
  variant      ProductVariant @relation(fields: [variant_id], references: [variant_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([variant_id, cart_id], map: "unique_cart_product")
  @@map("cart_items")
}

model Cart {
  cart_id    Int        @id @default(autoincrement())
  user_id    Int        @unique
  created_at DateTime?  @default(now()) @db.Timestamptz(6)
  updated_at DateTime?  @updatedAt @db.Timestamptz(6)
  cart_items CartItem[]
  users      User       @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@map("carts")
}

model Category {
  category_id   Int       @id @default(autoincrement())
  category_name String    @db.VarChar(255)
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  updated_at    DateTime? @updatedAt @db.Timestamptz(6)
  products      Product[]

  @@map("categories")
}

model Coupon {
  coupon_id            Int           @id @default(autoincrement())
  coupon_code          String        @unique @db.VarChar(100)
  discount_type        discount_type
  discount_value       Decimal       @db.Decimal(10, 2)
  minimum_order_amount Decimal       @db.Decimal(10, 2)
  usage_limit          Int
  start_date           DateTime      @db.Timestamptz(6)
  end_date             DateTime      @db.Timestamptz(6)
  status               coupon_status @default(ACTIVE)
  created_at           DateTime?     @default(now()) @db.Timestamptz(6)
  updated_at           DateTime?     @updatedAt @db.Timestamptz(6)

  @@map("coupons")
}

model Inventory {
  inventory_id      Int            @id @default(autoincrement())
  variant_id        Int            @unique
  stock_quantity    Int
  reserved_quantity Int            @default(0)
  updated_at        DateTime?      @updatedAt @db.Timestamptz(6)
  variant           ProductVariant @relation(fields: [variant_id], references: [variant_id], onDelete: Cascade, onUpdate: Cascade)

  @@map("inventory")
}

model Notification {
  notification_id   Int               @id @default(autoincrement())
  user_id           Int
  title             String            @db.VarChar(100)
  message           String
  notification_type notification_type
  reference_type    reference_type
  reference_id      Int?
  isread            Boolean?          @default(false)
  read_at           DateTime?         @db.Timestamptz(6)
  users             User              @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@map("notifications")
}

model OrderItem {
  item_id           Int            @id @default(autoincrement())
  product_id        Int
  order_id          Int
  variant_id        Int
  quantity          Int
  price_at_purchase Decimal        @db.Decimal(10, 2)
  created_at        DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?      @updatedAt @db.Timestamptz(6)
  orders            Order          @relation(fields: [order_id], references: [order_id], onDelete: NoAction, onUpdate: NoAction)
  products          Product        @relation(fields: [product_id], references: [product_id], onDelete: NoAction, onUpdate: NoAction)
  variant           ProductVariant @relation(fields: [variant_id], references: [variant_id], onDelete: NoAction, onUpdate: NoAction)
  returns           Return[]

  @@index([variant_id, order_id])
  @@map("order_items")
}

model Order {
  order_id                  Int            @id @default(autoincrement())
  order_number              String         @unique @db.VarChar(50)
  buyer_id                  Int
  status                    order_status   @default(PENDING)
  total_amount              Decimal        @db.Decimal(10, 2)
  shipping_name             String         @db.VarChar(50)
  shipping_phone_number     String         @db.VarChar(20)
  shipping_house_number     String?        @db.VarChar(20)
  shipping_apartment_number String?        @db.VarChar(20)
  shipping_street           String         @db.VarChar(100)
  shipping_city             String         @db.VarChar(100)
  shipping_state            String         @db.VarChar(100)
  shipping_country          String         @db.VarChar(100)
  shipping_postal_code      String         @db.VarChar(20)
  delivery_note             String?
  created_at                DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at                DateTime?      @updatedAt @db.Timestamptz(6)
  order_items               OrderItem[]
  users                     User           @relation(fields: [buyer_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  payments                  Payment[]
  shippinginfo              ShippingInfo[]

  @@index([buyer_id, status])
  @@map("orders")
}

model Payment {
  payment_id        Int            @id @default(autoincrement())
  order_id          Int
  payment_reference String         @unique @db.VarChar(100)
  amount            Decimal        @db.Decimal(10, 2)
  method            payment_method
  status            payment_status
  paid_at           DateTime?      @db.Timestamptz(6)
  created_at        DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?      @updatedAt @db.Timestamptz(6)
  orders            Order          @relation(fields: [order_id], references: [order_id], onDelete: NoAction, onUpdate: NoAction)
  refunds           Refund?

  @@map("payments")
}

model ProductVariant {
  variant_id      Int            @id @default(autoincrement())
  product_id      Int
  sku             String         @unique @db.VarChar(100)
  color           String         @db.VarChar(100)
  variant_storage String?        @db.VarChar(255)
  price           Decimal        @db.Decimal(10, 2)
  status          variant_status @default(ACTIVE)
  created_at      DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?      @updatedAt @db.Timestamptz(6)
  products        Product        @relation(fields: [product_id], references: [product_id], onDelete: Cascade, onUpdate: Cascade)
  inventory       Inventory?
  cartItems       CartItem[]
  orderItems      OrderItem[]

  @@map("product_variant")
}

model ProductImage {
  productimage_id Int       @id @default(autoincrement())
  product_id      Int
  image_url       String    @db.VarChar(255)
  display_order   Int?      @default(1)
  created_at      DateTime? @default(now()) @db.Timestamptz(6)
  updated_at      DateTime? @updatedAt @db.Timestamptz(6)
  products        Product   @relation(fields: [product_id], references: [product_id], onDelete: NoAction, onUpdate: NoAction)

  @@map("productimages")
}

model Product {
  product_id      Int              @id @default(autoincrement())
  product_name    String           @db.VarChar(255)
  description     String
  price           Decimal          @db.Decimal(10, 2)
  status          product_status   @default(DRAFT)
  category_id     Int
  store_id        Int
  created_at      DateTime?        @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?        @updatedAt @db.Timestamptz(6)
  order_items     OrderItem[]
  product_variant ProductVariant[]
  productimages   ProductImage[]
  categories      Category         @relation(fields: [category_id], references: [category_id], onDelete: NoAction, onUpdate: NoAction)
  stores          Store            @relation(fields: [store_id], references: [store_id], onDelete: NoAction, onUpdate: NoAction)
  wishlists       Wishlist[]
  reviews         Review[]

  @@index([category_id, store_id, status])
  @@map("products")
}

model Refund {
  refund_id    Int           @id @default(autoincrement())
  payment_id   Int           @unique
  amount       Decimal       @db.Decimal(10, 2)
  status       refund_status
  processed_at DateTime?     @db.Timestamptz(6)
  created_at   DateTime?     @default(now()) @db.Timestamptz(6)
  updated_at   DateTime?     @updatedAt @db.Timestamptz(6)
  payments     Payment       @relation(fields: [payment_id], references: [payment_id], onDelete: NoAction, onUpdate: NoAction)

  @@map("refunds")
}

model Return {
  return_id     Int            @id @default(autoincrement())
  order_item_id Int
  reason        String
  status        returns_status
  requested_at  DateTime?      @db.Timestamptz(6)
  approved_at   DateTime?      @db.Timestamptz(6)
  created_at    DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at    DateTime?      @updatedAt @db.Timestamptz(6)
  order_items   OrderItem      @relation(fields: [order_item_id], references: [item_id], onDelete: NoAction, onUpdate: NoAction)

  @@map("returns")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Review {
  review_id  Int       @id @default(autoincrement())
  buyer_id   Int
  product_id Int
  rating     Decimal   @db.Decimal(2, 1)
  comment    String?
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @updatedAt @db.Timestamptz(6)
  users      User      @relation(fields: [buyer_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  products   Product   @relation(fields: [product_id], references: [product_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([buyer_id, product_id])
  @@map("reviews")
}

model SellersPayout {
  payout_id  Int           @id @default(autoincrement())
  seller_id  Int
  amount     Decimal       @db.Decimal(10, 2)
  status     payout_status
  paid_at    DateTime?     @db.Timestamptz(6)
  created_at DateTime?     @default(now()) @db.Timestamptz(6)
  updated_at DateTime?     @updatedAt @db.Timestamptz(6)
  users      User          @relation(fields: [seller_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@map("sellers_payout")
}

model ShippingInfo {
  shipping_id             Int             @id @default(autoincrement())
  order_id                Int
  courier_name            String          @db.VarChar(100)
  tracking_number         String?         @unique @db.VarChar(100)
  shipping_status         shipping_status @default(PENDING)
  estimated_delivery_date DateTime?       @db.Timestamptz(6)
  shipped_at              DateTime?       @db.Timestamptz(6)
  delivered_at            DateTime?       @db.Timestamptz(6)
  created_at              DateTime?       @default(now()) @db.Timestamptz(6)
  updated_at              DateTime?       @updatedAt @db.Timestamptz(6)
  orders                  Order           @relation(fields: [order_id], references: [order_id], onDelete: NoAction, onUpdate: NoAction)

  @@map("shippinginfo")
}

model Store {
  store_id             Int       @id @default(autoincrement())
  store_name           String    @db.VarChar(255)
  description          String    @db.VarChar(255)
  logo                 String?   @db.VarChar(255)
  social_media_account String?   @db.VarChar(255)
  seller_id            Int       @unique
  created_at           DateTime? @default(now()) @db.Timestamptz(6)
  updated_at           DateTime? @updatedAt @db.Timestamptz(6)
  products             Product[]
  users                User      @relation(fields: [seller_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@map("stores")
}

model User {
  user_id        Int             @id @default(autoincrement())
  first_name     String          @db.VarChar(255)
  last_name      String          @db.VarChar(255)
  email          String          @unique @db.VarChar(50)
  phone_number   String?         @unique @db.VarChar(20)
  hash_password  String          @db.VarChar(255)
  role           user_role       @default(BUYER)
  created_at     DateTime?       @default(now()) @db.Timestamptz(6)
  updated_at     DateTime?       @updatedAt @db.Timestamptz(6)
  auditlogs      Auditlog[]
  carts          Cart?
  notifications  Notification[]
  orders         Order[]
  reviews        Review[]
  sellers_payout SellersPayout[]
  wishlists      Wishlist[]
  stores         Store?
  addresses      Address[]
  refreshTokens  RefreshToken[]

  @@map("users")
}

model Wishlist {
  wishlist_id Int       @id @default(autoincrement())
  user_id     Int
  product_id  Int
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @updatedAt @db.Timestamptz(6)
  products    Product   @relation(fields: [product_id], references: [product_id], onDelete: NoAction, onUpdate: NoAction)
  users       User      @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([user_id, product_id])
  @@map("wishlists")
}

model RefreshToken {
  refresh_token_id Int       @id @default(autoincrement())
  user_id          Int
  token_hash       String    @unique
  expires_at       DateTime
  revoked_at       DateTime?
  created_at       DateTime  @default(now())

  users User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id])
  @@index([token_hash])
  @@map("refresh_tokens")
}

enum addresstype {
  HOME
  OFFICE
}

enum coupon_status {
  ACTIVE
  INACTIVE
  EXPIRED
}

enum discount_type {
  PERCENTAGE
  FIXED_AMOUNT
}

enum notification_type {
  ORDER
  PAYMENT
  SHIPPING
  COUPON
  PROMOTION
  REVIEW
  SYSTEM
}

enum order_status {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum payment_method {
  CARD
  BANK_TRANSFER
  WALLET
  CASH_ON_DELIVERY
}

enum payment_status {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  CANCELLED
}

enum payout_status {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

enum product_status {
  DRAFT
  ACTIVE
  ARCHIVED
  DISABLED
}

enum reference_type {
  ORDER
  PRODUCT
  USER
  SELLER
  PAYMENT
  REVIEW
  RETURN
  COUPON
  DISPUTE
  PAYOUT
  CATEGORY
  SYSTEM
}

enum refund_status {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
}

enum returns_status {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  COMPLETED
}

enum shipping_status {
  PENDING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
}

enum user_role {
  BUYER
  SELLER
  ADMIN
}

enum variant_status {
  ACTIVE
  OUT_OF_STOCK
  DISABLED
  ARCHIVED
}
